meta {
  name: Upload Patient File
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/patients/{{patientId}}/files
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file(../fixtures/sample.pdf)
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("patientFileId", res.body.data._id);
}
