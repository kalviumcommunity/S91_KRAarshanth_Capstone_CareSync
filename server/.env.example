PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ihros
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
# Optional Gemini department specialty autocomplete. Keep the provider key server-side.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest

# Optional one-time super-admin bootstrap (never expose these values in Git)
# BOOTSTRAP_ADMIN_NAME=Hospital Super Admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters

# Optional isolated test database (must be a disposable database)
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/ihros_test
